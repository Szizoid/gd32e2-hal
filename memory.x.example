/* Template for the linker script the examples need. Copy to `memory.x`, which is
   git-ignored, and adjust the lengths to your part: the values below are for the
   GD32E230K8 (64K flash, 8K RAM). */

MEMORY
{
    FLASH : ORIGIN = 0x08000000, LENGTH = 64K
    RAM   : ORIGIN = 0x20000000, LENGTH = 8K
}
